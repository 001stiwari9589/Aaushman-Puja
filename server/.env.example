PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/vedic_puja

# Comma-separated allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# Generate a strong 64+ character random secret
JWT_SECRET=replace_with_strong_random_jwt_secret

# Admin credentials (generate hash with: node -e "import('bcryptjs').then(b=>console.log(b.default.hashSync('YOUR_PASSWORD', 12)))")
ADMIN_USER=replace_with_admin_username
ADMIN_PASS_HASH=replace_with_bcrypt_hash

# Notification recipient email
ADMIN_EMAIL=001stiwari9589@gmail.com

# SMTP Settings for Nodemailer (For Gmail, use a 16-character Gmail App Password, NOT your regular Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM="Divine Vedic Puja Sansthan" <your_gmail@gmail.com>
